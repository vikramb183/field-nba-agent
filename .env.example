# Copy to .env and fill in. Everything is optional:
# with nothing set, the app runs fully in memory with a keyword-based triage.

# Neo4j knowledge graph (docker compose starts one for you)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=localpassword

# Redis cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# LLM (leave blank to use the offline fallback)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Guardrail thresholds
MIN_TRIAGE_CONFIDENCE=0.35
LOW_SCORE_THRESHOLD=0.25
